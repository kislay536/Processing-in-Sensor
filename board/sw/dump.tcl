connect
targets -set -filter {name =~ "ARM*#0"}
foreach {n a} {GEM0_RCLK_CTRL 0xF8000138 GEM0_CLK_CTRL 0xF8000140 MIO16 0xF8000740 MIO27 0xF800076C MIO52 0xF80007D0 MIO53 0xF80007D4 NWCTRL 0xE000B000 NWCFG 0xE000B004 NWSR 0xE000B008 DDR_CLK 0xF8000100 ARM_CLK 0xF8000120 APER_CLK 0xF800012C SLCR_LOCK 0xF8000004} {
  puts [format "%-14s %s = 0x%08x" $n $a [mrd -force -value $a]]
}
