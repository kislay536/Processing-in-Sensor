<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EventCam Dashboard</title>
<style>
  :root {
    --bg: #f4f5f7; --panel: #ffffff; --ink: #14171c; --muted: #5b6573; --line: #d9dde3;
    --ok: #12805c; --warn: #a15c00; --bad: #b42318; --accent: #2457d6; --chip: #eef1f5;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0f1216; --panel: #181c22; --ink: #e8ebf0; --muted: #9aa4b2; --line: #2b323c;
      --ok: #3ccf9b; --warn: #f0b14a; --bad: #ff7b72; --accent: #7aa2ff; --chip: #222831;
    }
  }
  :root[data-theme="dark"] {
    --bg: #0f1216; --panel: #181c22; --ink: #e8ebf0; --muted: #9aa4b2; --line: #2b323c;
    --ok: #3ccf9b; --warn: #f0b14a; --bad: #ff7b72; --accent: #7aa2ff; --chip: #222831;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  .wrap { max-width: 1240px; margin: 0 auto; padding: 16px; }
  header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; margin-bottom: 12px; }
  h1 { font-size: 20px; margin: 0; }
  .sub { color: var(--muted); font-size: 13px; }
  .flow { display: flex; flex-wrap: wrap; gap: 8px; align-items: stretch; margin-bottom: 16px; }
  .stage { flex: 1 1 150px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; min-width: 150px; }
  .stage .k { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .stage .v { font-size: 22px; font-weight: 650; font-variant-numeric: tabular-nums; }
  .stage .n { font-size: 12px; color: var(--muted); }
  .arrow { align-self: center; color: var(--muted); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } .arrow { display: none; } }
  .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  .panel h2 { font-size: 15px; margin: 0; padding: 10px 12px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; gap: 8px; align-items: center; }
  .panel h2 small { color: var(--muted); font-weight: 400; font-size: 12px; }
  .vid { position: relative; background: #000; aspect-ratio: 4 / 3; }
  .vid img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .vid .ph { position: absolute; inset: 0; display: grid; place-items: center; color: #9aa4b2; font-size: 14px; text-align: center; padding: 16px; }
  .meta { padding: 10px 12px; display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { background: var(--chip); border-radius: 999px; padding: 2px 10px; font-size: 12.5px; font-variant-numeric: tabular-nums; }
  .chip.ok { color: var(--ok); } .chip.bad { color: var(--bad); } .chip.warn { color: var(--warn); }
  .events { margin-top: 16px; }
  .banner { padding: 12px; border-bottom: 1px solid var(--line); font-size: 14px; }
  .banner.warn { color: var(--warn); }
  .ev { padding: 12px; border-bottom: 1px solid var(--line); }
  .ev:last-child { border-bottom: 0; }
  .ev .t { font-weight: 600; margin-bottom: 6px; }
  .thumbs { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; }
  .thumbs img { width: 100%; border-radius: 6px; display: block; aspect-ratio: 4/3; object-fit: cover; }
  @media (max-width: 620px) { .thumbs { grid-template-columns: repeat(3, 1fr); } }
  .empty { padding: 20px 12px; color: var(--muted); }

  .detgrid { display: grid; grid-template-columns: 260px 1fr; gap: 16px; padding: 12px; }
  @media (max-width: 820px) { .detgrid { grid-template-columns: 1fr; } }
  .light { display: flex; align-items: center; gap: 10px; font-size: 18px; font-weight: 650; margin-bottom: 8px; }
  .dot { width: 18px; height: 18px; border-radius: 50%; background: var(--line); flex: none; }
  .dot.on { background: var(--bad); box-shadow: 0 0 10px var(--bad); }
  .dot.hold { background: var(--warn); }
  #cells { width: 100%; aspect-ratio: 1; image-rendering: pixelated; border: 1px solid var(--line); border-radius: 8px; background: #000; }
  .bar { position: relative; height: 22px; border: 1px solid var(--line); border-radius: 6px; background: var(--panel); overflow: hidden; }
  .bar i { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: var(--accent); opacity: .55; transition: width .4s; }
  .bar b { position: relative; font: 12px/22px ui-monospace, monospace; padding-left: 8px; }
  #spark { width: 100%; height: 90px; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); }
  .params { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 8px; margin-top: 10px; }
  .params label { font-size: 12px; color: var(--muted); display: flex; flex-direction: column; gap: 2px; }
  .params input { font: inherit; padding: 4px 6px; border: 1px solid var(--line); border-radius: 6px; background: var(--panel); color: var(--ink); width: 100%; }
  button { font: inherit; padding: 6px 12px; border-radius: 8px; border: 1px solid var(--line); background: var(--chip); color: var(--ink); cursor: pointer; }
  button.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
  .row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; align-items: center; }
  footer { color: var(--muted); font-size: 12px; margin-top: 14px; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>EventCam</h1>
    <span class="sub">camera &rarr; laptop (relay only) &rarr; Zedboard DDR ring &rarr; image-change detector in the FPGA fabric &rarr; GPU</span>
  </header>

  <div class="flow" aria-label="pipeline counters">
    <div class="stage"><div class="k">Camera</div><div class="v" id="s-cam">–</div><div class="n" id="s-cam-n">fps, 640×480 YUYV</div></div>
    <div class="arrow">&rarr;</div>
    <div class="stage"><div class="k">Kept (1 of 5)</div><div class="v" id="s-kept">–</div><div class="n" id="s-kept-n">frames relayed</div></div>
    <div class="arrow">&rarr;</div>
    <div class="stage"><div class="k">Board ring</div><div class="v" id="s-ring">–</div><div class="n" id="s-ring-n">of 60 slots in use, oldest overwritten</div></div>
    <div class="arrow">&rarr;</div>
    <div class="stage"><div class="k">FPGA detector</div><div class="v" id="s-det">–</div><div class="n" id="s-det-n">image-change, 64×64 grid</div></div>
    <div class="arrow">&rarr;</div>
    <div class="stage"><div class="k">GPU events</div><div class="v" id="s-ev">0</div><div class="n">windows received</div></div>
  </div>

  <div class="grid">
    <section class="panel">
      <h2>1 · Live camera <small>laptop, straight from the camera</small></h2>
      <div class="vid"><img id="live" alt="live camera"><div class="ph" id="live-ph">waiting for camera…</div></div>
      <div class="meta" id="live-meta"></div>
      <div class="meta" style="align-items:center"><label class="sub" for="drop">Frames dropped after each frame sent to the FPGA (0 = send every frame):</label>
        <input id="drop" type="number" min="0" max="1000" value="0" style="width:80px;font:inherit;padding:4px 6px;border:1px solid var(--line);border-radius:6px;background:var(--panel);color:var(--ink)">
        <button id="drop-set">Set</button><span class="sub" id="drop-msg"></span></div>
    </section>
    <section class="panel">
      <h2>2 · What the FPGA board holds <small>read back from its DDR, ~2 per second</small></h2>
      <div class="vid"><img id="board" alt="frame read from board"><div class="ph" id="board-ph">waiting for the board…</div></div>
      <div class="meta" id="board-meta"></div>
    </section>
  </div>

  <section class="panel events">
    <h2>3 · FPGA detector <small>image-change-detector running in the PL; the ARM core only reads its result</small></h2>
    <div class="detgrid">
      <div>
        <div class="light"><span class="dot" id="dot"></span><span id="dstate">–</span></div>
        <canvas id="cells" width="8" height="8"></canvas>
        <div class="sub" style="margin-top:4px">8×8 cells of the centre crop (512×256 of the frame); brighter = more changed pixels (64 per cell).</div>
      </div>
      <div>
        <div class="meta" id="det-meta" style="padding:0 0 8px"></div>
        <canvas id="spark" width="600" height="90"></canvas>
        <div class="sub">changed pixels (of 4096) per colour frame, newest on the right; red = detector fired.</div>
        <canvas id="bands" width="600" height="70" style="width:100%;height:70px;margin-top:8px;border:1px solid var(--line);border-radius:8px"></canvas>
        <div class="sub">microphone: power in 8 bands (125 Hz … 6 kHz, log scale) from the audio IP in the PL.</div>
        <div class="params" id="params"></div>
        <div class="row"><button class="primary" id="apply">Apply parameters</button><button id="reset">Reset background</button><button id="clear" style="color:var(--bad)">Reset &amp; delete all events</button><span class="sub" id="cfg-msg"></span></div>
      </div>
    </div>
    <div class="banner" id="det-banner"></div>
    <div id="events"><div class="empty">No events yet.</div></div>
  </section>

  <section class="panel">
    <h2>4 · GPU stage <small>laptop RTX GPU · small model stays loaded, idle until a chunk arrives</small></h2>
    <div class="meta" id="gpu-meta" style="padding:0 0 8px"></div>
    <div class="detgrid">
      <div><div class="sub">GPU utilisation %</div><div class="bar"><i id="g-util"></i><b id="g-util-t"></b></div>
        <div class="sub" style="margin-top:8px">GPU memory</div><div class="bar"><i id="g-mem"></i><b id="g-mem-t"></b></div>
        <div class="sub" style="margin-top:8px">Power</div><div class="bar"><i id="g-pow"></i><b id="g-pow-t"></b></div>
        <div class="sub" style="margin-top:8px">Temperature</div><div class="bar"><i id="g-temp"></i><b id="g-temp-t"></b></div></div>
      <div><canvas id="gspark" width="600" height="110" style="width:100%;height:110px;border:1px solid var(--line);border-radius:8px;background:var(--panel)"></canvas>
        <div class="sub">last 2 min: utilisation (blue) and memory (green), newest on the right.</div>
        <div class="sub" id="g-procs" style="margin-top:6px"></div></div>
    </div>
  </section>

  <footer>Panels 2 and 3 are real: the detector panel shows the registers of the PL image-change IP as read by the board firmware. Panel 2: each image is fetched from the board's DDR over Ethernet and marked verified only if the board's CRC (computed from DDR) equals the relay's CRC for that frame.</footer>
</div>

<script>
const $ = id => document.getElementById(id);
const chip = (txt, cls) => `<span class="chip ${cls || ''}">${txt}</span>`;
let liveSeen = false, boardSeen = false;

function attach(imgId, phId, url) {
  const img = $(imgId);
  img.onload = () => { $(phId).style.display = 'none'; };
  img.src = url;
}
attach('live', 'live-ph', '/live.mjpg');
attach('board', 'board-ph', '/board.mjpg');

async function poll() {
  try {
    const s = await (await fetch('/api/status')).json();
    const c = s.camera, r = s.relay, b = s.board, bs = b.stats;
    gpuPanel(s.gpu);
    $('s-cam').textContent = c.fps.toFixed(1);
    $('s-kept').textContent = r.kept;
    if (!dropInit) { $('drop').value = r.drop_n; dropInit = true; }
    $('s-kept-n').previousElementSibling.textContent = r.drop_n === 0 ? 'Kept (every frame)' : `Kept (1 of ${r.drop_n + 1})`;
    $('s-kept-n').textContent = `sent ${r.sent_ok} · ${r.mbps} Mb/s`;
    $('s-ring').textContent = b.stats ? b.ring_fill : '–';
    $('live-meta').innerHTML = c.error ? chip(c.error, 'bad')
      : chip(`${c.fps.toFixed(1)} fps`, c.fps > 25 ? 'ok' : 'warn') + chip(`${c.frames} frames`) + chip(`${c.width}×${c.height} YUYV`);
    let m = chip(b.connected ? 'board connected' : 'board not connected', b.connected ? 'ok' : 'bad');
    if (bs) {
      m += chip(`${bs.frames_rx} frames received in total`) + chip(`ring keeps the newest ${b.ring_slots}`) + chip(`CRC errors ${bs.crc_err}`, bs.crc_err ? 'bad' : 'ok')
         + chip(`frame gaps ${bs.fid_gaps}`, bs.fid_gaps ? 'warn' : 'ok');
    }
    if (b.shown) {
      const v = b.shown;
      m += chip(`frame #${v.fid} · slot ${v.slot}`) + (v.verified ? chip('verified from DDR', 'ok') : chip('CRC not matched', 'bad'));
    }
    $('board-meta').innerHTML = m;
    const d = s.detector;
    if (!d.running) { $('det-banner').textContent = d.note; $('s-det').textContent = '–'; }
    else {
      buildParams(d.params);
      const fired = d.fired === 1, hold = d.reason_name.includes('global') || d.reason_name === 'exposure_rebase';
      $('dot').className = 'dot' + (fired ? ' on' : hold ? ' hold' : '');
      $('dstate').textContent = fired ? 'MOTION' : hold ? ('suppressed: ' + d.reason_name.replace('_', ' ')) : d.reason_name === 'warmup' ? 'warming up' : 'quiet';
      $('s-det').textContent = fired ? 'MOTION' : 'quiet';
      $('s-det-n').textContent = `score ${d.score} · ${d.changed} px changed`;
      $('det-meta').innerHTML = chip(`reason: ${d.reason_name}`, fired ? 'bad' : '') + chip(`score ${d.score}/255`) + chip(`${d.changed} px changed`) + chip(`${d.active_cells} active cells`)
        + chip(`persistence ${d.persistence}`) + chip(`PL time ${d.img_us} µs`) + chip(`motion episodes ${d.onsets}`) + chip(`frames streamed ${d.frames_sent}`, d.frames_sent ? 'ok' : '') + chip(`chunks ${d.chunks_sent}`, d.chunks_sent ? 'ok' : '')
        + chip(`frames lost ${d.frames_lost}`, d.frames_lost ? 'bad' : '') + chip(`no-client episodes ${d.episodes_dropped}`, d.episodes_dropped ? 'warn' : '') + chip(d.event_state_name, d.event_state ? 'bad' : '') + chip(d.gpu_client ? 'GPU client connected' : 'no GPU client', d.gpu_client ? 'ok' : 'warn')
        + chip(`IR frames ${d.ir_frames} · changed ${d.ir_changed}/2304 px`, d.ir_capture.error ? 'bad' : '') + chip(`audio blocks ${d.aud_blocks}`, d.mic.error ? 'bad' : '') + (d.ir_capture.error ? chip(d.ir_capture.error, 'bad') : '');
      $('det-banner').textContent = '';
      drawDet(d);
    }
  } catch (e) {
    $('board-meta').innerHTML = chip('dashboard server not reachable', 'bad');
  }
}

const esc = t => String(t == null ? '' : t).replace(/[&<>]/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;'}[c]));
const tfmt = us => { if (!us) return '–'; const d = new Date(us / 1000); return d.toLocaleTimeString([], {hour12: false}) + '.' + String(d.getMilliseconds()).padStart(3, '0'); };
async function events() {
  try {
    const list = await (await fetch('/api/events')).json();
    $('s-ev').textContent = list.length;
    if (!list.length) { $('events').innerHTML = '<div class="empty">No events yet.</div>'; return; }
    $('events').innerHTML = list.map(e => `
      <div class="ev">
        <div class="t">${e.kind === 'context' ? 'Scene context' : 'Motion chunk'} ${e.event_id} · ${e.kind === 'context' ? '' : `episode ${e.episode} part ${e.chunk + 1} · `}${e.n_frames} frames · ${e.duration_s} s @ ${e.fps} fps · ended: ${e.end_reason}</div>
        <div class="sub">window ${tfmt(e.first_ts_us)} → ${tfmt(e.last_ts_us)} (laptop clock, when each frame was read from the camera) · motion detected at ${tfmt(e.trigger_ts_us)}</div>
        ${e.scene && e.scene.summary ? `<div style="font-weight:600;white-space:pre-wrap">${esc(e.scene.summary)}</div>
          <div class="sub">${(e.scene.timeline || []).map(g => `<b>+${g.interval_s[0].toFixed(1)}–${g.interval_s[1].toFixed(1)} s (${g.clock[0]})</b> ${esc(g.description)}`).join('<br>')}</div>
          <details><summary class="sub">coverage, limits, runtime (${e.scene.status}, ${e.scene.runtime.elapsed_seconds} s)</summary><div class="sub">processed ${JSON.stringify(e.scene.coverage.processed_intervals_s)} of ${JSON.stringify(e.scene.coverage.requested_interval_s)} s · sampled frames at +${(e.scene.coverage.sampled_frame_timestamps_s || []).join(', ')} s · GPU memory in use peak ${e.scene.runtime.peak_gpu_mem_used_mib} MiB (all processes)<br>${(e.scene.limitations || []).map(esc).join('<br>')}</div></details>
          <div class="sub">${e.det ? 'People (YOLO): ' + esc(e.det.text) : ''}</div>`
          : (e.pending ? `<div class="sub" style="font-weight:600">analysing on the GPU…</div>` : `<div class="sub" style="font-weight:600">${e.det ? esc(e.det.text) : esc(e.summary || '')}</div>`)}
        ${e.det && e.det.timeline && e.det.timeline.length ? `<div class="sub">${e.det.timeline.map(g => `<b>+${g.start_s.toFixed(1)}–${g.end_s.toFixed(1)} s</b> ${g.text}`).join(' &nbsp;·&nbsp; ')}</div>` : ''}
        ${e.det ? `<div class="thumbs">${e.det.keyframes.map(k => `<figure style="margin:0"><img loading="lazy" style="max-width:320px" src="/events/${e.name}/${k.file}" alt=""><figcaption class="sub" style="font-size:11px">${tfmt(k.ts_us)} · ${k.n} person(s)</figcaption></figure>`).join('')}</div>` : ''}
        <div class="thumbs">${e.thumbs.map((f, i) => `<figure style="margin:0"><img loading="lazy" src="/events/${e.name}/${f}" alt=""><figcaption class="sub" style="font-size:11px">${tfmt(e.thumb_ts_us[i])}</figcaption></figure>`).join('')}</div>
      </div>`).join('');
  } catch (e) {}
}


const PARAMS = [['pix_min','pixel threshold min'],['min_cells','min active cells'],['cell_req','pixels per cell (of 64)'],['persist_frames','persistence frames'],
                ['var_shift','variation shift'],['global_limit','global-change limit'],['pre','frames sent before motion'],['hang','frames sent after motion stops'],['max_chunk_s','max chunk length (s)'],['ctx_period_s','scene context every (s, 0 = off)'],['ctx_frames','scene context frames']];
let paramsBuilt = false;
function buildParams(p) {
  if (paramsBuilt) return; paramsBuilt = true;
  $('params').innerHTML = PARAMS.map(([k, l]) => `<label>${l}<input id="p-${k}" type="number" value="${p[k]}"></label>`).join('');
}
async function post(url, body) { return (await fetch(url, {method: 'POST', body: JSON.stringify(body || {})})).json(); }
$('apply').onclick = async () => {
  const body = {}; PARAMS.forEach(([k]) => { body[k] = +$('p-' + k).value; });
  const r = await post('/api/config', body); $('cfg-msg').textContent = r.ok ? 'sent to board' : 'board not connected';
};
$('drop-set').onclick = async () => {
  const r = await post('/api/drop', {n: +$('drop').value}); $('drop-msg').textContent = r.ok ? `now dropping ${r.drop_n} after each sent frame` : 'invalid';
};
let dropInit = false;
$('clear').onclick = async () => {
  if (!confirm('Reset the detector and permanently delete ALL captured events?')) return;
  const r = await post('/api/clear'); $('cfg-msg').textContent = r.ok ? `detector reset, ${r.removed} events deleted` : `${r.removed} events deleted (board not connected, detector not reset)`;
  events();
};
$('reset').onclick = async () => { const r = await post('/api/reset'); $('cfg-msg').textContent = r.ok ? 'background reset' : 'board not connected'; };

function drawBands(d) {
  const c = $('bands'), x = c.getContext('2d'), w = c.width, h = c.height; x.clearRect(0, 0, w, h);
  const n = 8, bw = w / n;
  d.bands.forEach((v, i) => { const l = v > 0 ? Math.min(1, Math.log10(v) / 12) : 0; x.fillStyle = '#12805c'; x.fillRect(i * bw + 4, h - l * (h - 4) - 2, bw - 8, l * (h - 4) + 1); });
}
function drawDet(d) {
  drawBands(d);
  const cv = $('cells'), cx = cv.getContext('2d'), im = cx.createImageData(8, 8);
  d.cells.forEach((v, i) => { const g = Math.min(255, v * 4); im.data.set([g, g, g, 255], i * 4); });
  cx.putImageData(im, 0, 0);
  const sp = $('spark'), sx = sp.getContext('2d'), w = sp.width, h = sp.height, H = d.history || [];
  sx.clearRect(0, 0, w, h);
  const bw = w / 120;
  H.forEach((e, i) => { const x = w - (H.length - i) * bw, hh = Math.min(1, e[2] / 1500) * (h - 4);
    sx.fillStyle = e[3] ? '#b42318' : '#2457d6'; sx.fillRect(x, h - hh - 2, Math.max(1, bw - 1), Math.max(1, hh)); });
}

poll(); events();
setInterval(poll, 500);
function gpuPanel(g) {
  if (!g) return; const n = g.now || {}, m = g.model || {};
  const set = (id, pct, txt) => { $(id).style.width = Math.max(0, Math.min(100, pct || 0)) + '%'; $(id + '-t').textContent = txt; };
  set('g-util', n.util, n.util == null ? '–' : n.util + ' %');
  set('g-mem', 100 * n.mem_used / n.mem_total, n.mem_used == null ? '–' : `${n.mem_used.toFixed(0)} / ${n.mem_total.toFixed(0)} MiB`);
  set('g-pow', 100 * n.power / n.power_limit, n.power == null ? '–' : `${n.power.toFixed(1)} / ${n.power_limit ? n.power_limit.toFixed(0) : '?'} W`);
  set('g-temp', n.temp, n.temp == null ? '–' : n.temp + ' °C' + (n.clock ? ` · ${n.clock} MHz` : ''));
  const v = g.vlm;
  $('gpu-meta').innerHTML = (v ? chip(`${v.name}: ${v.state}${g.pending ? ' · ' + g.pending + ' chunk(s) queued' : ''}`, v.busy ? 'bad' : (v.loaded ? 'ok' : 'warn')) + (v.analyzed ? chip(`scene reports ${v.analyzed} · last ${v.last_s} s`) : '') : chip('VLM agent not installed', 'warn')) + chip(m.name + ': ' + m.state, m.busy ? 'bad' : (m.loaded ? 'ok' : 'warn')) + chip(`chunks analysed ${m.analyzed}`) + (m.analyzed ? chip(`last ${m.last_s} s`) : '') + (m.device ? chip(m.device) : '') + (m.error ? chip(m.error, 'bad') : '') + (g.error ? chip('nvidia-smi: ' + g.error, 'bad') : '');
  $('g-procs').textContent = 'GPU processes: ' + ((g.procs || []).map(p => `${p.name} (pid ${p.pid}) ${p.mem.toFixed(0)} MiB`).join(' · ') || 'none');
  const c = $('gspark'), x = c.getContext('2d'), w = c.width, h = c.height, H = g.hist || [];
  x.clearRect(0, 0, w, h); x.strokeStyle = 'rgba(128,128,128,.25)'; x.lineWidth = 1;
  for (const y of [.25, .5, .75]) { x.beginPath(); x.moveTo(0, h * y); x.lineTo(w, h * y); x.stroke(); }
  const line = (idx, scale, col) => { x.strokeStyle = col; x.lineWidth = 2; x.beginPath(); H.forEach((r, i) => { const px = w - (H.length - 1 - i) * (w / 120), py = h - 2 - (h - 4) * Math.min(1, (r[idx] || 0) / scale); i ? x.lineTo(px, py) : x.moveTo(px, py); }); x.stroke(); };
  line(2, n.mem_total || 4096, '#3ccf9b'); line(1, 100, '#7aa2ff');
}
setInterval(events, 3000);
</script>
</body>
</html>
